# ==============================================================================
# LIVE / PRODUCTION ENVIRONMENT CONFIGURATION
# Upload this file as ".env" to your live server root.
# DO NOT commit this file to Git — it contains secrets.
# ==============================================================================

# Environment Type
WP_ENVIRONMENT_TYPE="production"

# ── Database Configuration ────────────────────────────────────────────────────
# Replace these with your actual Hostinger database credentials
# (cPanel → Databases → MySQL Databases)
DB_NAME="your_live_db_name"
DB_USER="your_live_db_user"
DB_PASSWORD="your_live_db_password"
DB_HOST="localhost"
DB_CHARSET="utf8mb4"
DB_COLLATE=""

# ── Site URLs ─────────────────────────────────────────────────────────────────
# Leave these BLANK — wp-config.php will auto-detect the domain from HTTP_HOST.
# Only fill these in if you want to force a specific URL override.
# WP_HOME=""
# WP_SITEURL=""

# ── Security Salts & Keys ────────────────────────────────────────────────────
# Generate new salts at: https://api.wordpress.org/secret-key/1.1/salt/
AUTH_KEY="REPLACE_WITH_UNIQUE_SALT"
SECURE_AUTH_KEY="REPLACE_WITH_UNIQUE_SALT"
LOGGED_IN_KEY="REPLACE_WITH_UNIQUE_SALT"
NONCE_KEY="REPLACE_WITH_UNIQUE_SALT"
AUTH_SALT="REPLACE_WITH_UNIQUE_SALT"
SECURE_AUTH_SALT="REPLACE_WITH_UNIQUE_SALT"
LOGGED_IN_SALT="REPLACE_WITH_UNIQUE_SALT"
NONCE_SALT="REPLACE_WITH_UNIQUE_SALT"

# ── Integration API Keys ──────────────────────────────────────────────────────
ASCENDANCE_GTM_ID="GTM-XXXXXXX"
ASCENDANCE_NEWSLETTER_API_KEY=""
ASCENDANCE_NEWSLETTER_LIST_ID=""

# ── Login Security — Hidden URL ───────────────────────────────────────────────
WP_LOGIN_SLUG="portal"

# ── Google reCAPTCHA v3 ───────────────────────────────────────────────────────
RECAPTCHA_SITE_KEY="6Lf0TlEtAAAAAOL09jyexgRF-pA5l7yAc1zuK0Xy"
RECAPTCHA_SECRET_KEY="6Lf0TlEtAAAAAAlxhIuqr_yNXVAD_Ed3Zyv-sUA1"
RECAPTCHA_THRESHOLD="0.5"

# ── Payments (Stripe) ─────────────────────────────────────────────────────────
# Replace with your LIVE Stripe keys (not test keys!)
STRIPE_PUBLISHABLE_KEY="pk_live_REPLACE_WITH_LIVE_KEY"
STRIPE_SECRET_KEY="sk_live_REPLACE_WITH_LIVE_KEY"
STRIPE_WEBHOOK_SECRET="whsec_REPLACE_WITH_LIVE_WEBHOOK_SECRET"
