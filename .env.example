# ==============================================================================
# ASCENDANCE ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your local credentials. Do not commit .env!
# ==============================================================================

# Environment Type (local, staging, production)
WP_ENVIRONMENT_TYPE="local"

# Database Configuration
DB_NAME="ascendance"
DB_USER="root"
DB_PASSWORD=""
DB_HOST="localhost"
DB_CHARSET="utf8mb4"
DB_COLLATE=""

# Site URLs
WP_HOME="http://localhost/Ascendance"
WP_SITEURL="http://localhost/Ascendance"

# Security Salts & Keys
# Generate fresh salts here: https://api.wordpress.org/secret-key/1.1/salt/
AUTH_KEY="insert-random-string-here"
SECURE_AUTH_KEY="insert-random-string-here"
LOGGED_IN_KEY="insert-random-string-here"
NONCE_KEY="insert-random-string-here"
AUTH_SALT="insert-random-string-here"
SECURE_AUTH_SALT="insert-random-string-here"
LOGGED_IN_SALT="insert-random-string-here"
NONCE_SALT="insert-random-string-here"

# Integration API Keys (Modules 12 & 13)
ASCENDANCE_GTM_ID="GTM-XXXXXXX"
ASCENDANCE_NEWSLETTER_API_KEY=""
ASCENDANCE_NEWSLETTER_LIST_ID=""

# Login Security — Hidden URL (Module 13)
# Choose a secret slug for the login page (no leading slash, no spaces).
# After changing, flush permalinks: WP Admin → Settings → Permalinks → Save.
WP_LOGIN_SLUG="portal"

# Google reCAPTCHA v3 — invisible, score-based CAPTCHA (Module 14)
# Register at https://www.google.com/recaptcha/admin/create → choose reCAPTCHA v3.
# Leave blank to disable (CAPTCHA is always skipped in local environment).
RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""
# Score threshold: 0.0 = bot, 1.0 = human. Recommended: 0.5
RECAPTCHA_THRESHOLD="0.5"

# Payments (Stripe)
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# AI Editorial Studio API Keys
ANTHROPIC_API_KEY="sk-ant-api03-..."
OPENAI_API_KEY="sk-..."
GEMINI_API_KEY="..."

# Newsletter & Transactional Email (Brevo)
BREVO_API_KEY="xkeysib-..."

# Redis Object Cache (Staging/Production Optional)
WP_REDIS_HOST="127.0.0.1"
WP_REDIS_PORT="6379"

