# ==============================================================================
# ASCENDANCE — SMART .htaccess
# Auto-adapts to any domain/environment. No hardcoded paths.
# Local  → http://localhost/Ascendance/   (subdirectory install)
# Live   → https://your-domain.com/       (root install)
# ==============================================================================

# ── 1. WebP Image Redirection ─────────────────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_ACCEPT} image/webp
  RewriteCond %{DOCUMENT_ROOT}/$1.webp -f
  RewriteRule (.+)\.(jpe?g|png)$ $1.$2.webp [T=image/webp,E=accept:1]
</IfModule>
<IfModule mod_headers.c>
  Header append Vary Accept env=REDIRECT_accept
</IfModule>

# ── 2. Cache-Control & Compression ───────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css \
        text/javascript application/javascript application/x-javascript \
        application/json image/svg+xml
</IfModule>
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType text/css                  "access plus 1 year"
    ExpiresByType text/javascript           "access plus 1 year"
    ExpiresByType application/javascript    "access plus 1 year"
    ExpiresByType application/x-javascript "access plus 1 year"
    ExpiresByType image/jpeg                "access plus 1 year"
    ExpiresByType image/png                 "access plus 1 year"
    ExpiresByType image/gif                 "access plus 1 year"
    ExpiresByType image/webp                "access plus 1 year"
    ExpiresByType image/avif                "access plus 1 year"
    ExpiresByType image/svg+xml            "access plus 1 year"
    ExpiresByType font/woff                 "access plus 1 year"
    ExpiresByType font/woff2                "access plus 1 year"
    ExpiresByType application/font-woff    "access plus 1 year"
    ExpiresByType application/font-woff2   "access plus 1 year"
</IfModule>

# ── 3. Security Headers ───────────────────────────────────────────────────────
<IfModule mod_headers.c>
  # Note: X-Frame-Options is managed by mu-plugin security-hardening.php
  # to allow WP Customizer iframe preview. Use 'set' (not 'always set') so
  # PHP headers from WordPress core can override it for the Customizer.
  Header set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer-when-downgrade"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
  Header set Content-Security-Policy "default-src 'self' blob: data:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https: blob:; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: https:; font-src 'self' data: https:; frame-src 'self' blob: data: https://www.google.com https://recaptcha.google.com; child-src 'self' blob: https://www.google.com https://recaptcha.google.com; frame-ancestors 'self';"
</IfModule>

# ── 4. Block Sensitive Files ──────────────────────────────────────────────────
<FilesMatch "(^\.|wp-config\.php)$">
  Require all denied
</FilesMatch>
<Files xmlrpc.php>
  Require all denied
</Files>
<IfModule mod_rewrite.c>
  RewriteRule (^|/)(?:\.env|wp-config\.php) - [F,L]
</IfModule>

# ── 5. Auto-Detect Environment ────────────────────────────────────────────────
# Sets SITE_ENV=local when on localhost or 127.0.0.1
# On any real/live domain, SITE_ENV is unset (treated as "live")
SetEnvIf Host "^localhost(:\d+)?$"   SITE_ENV=local
SetEnvIf Host "^127\.0\.0\.1(:\d+)?$" SITE_ENV=local

# ── 6. Legacy 301 Redirects (Auto-path based on environment) ─────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On

  # — LOCAL: prefix redirects with /Ascendance/ ————————————————————————————
  RewriteCond %{ENV:SITE_ENV} =local
  RewriteRule ^contact-us/?$ /Ascendance/contact/ [R=301,L]

  RewriteCond %{ENV:SITE_ENV} =local
  RewriteRule ^services-and-industries/?$ /Ascendance/services/ [R=301,L]

  RewriteCond %{ENV:SITE_ENV} =local
  RewriteRule ^blog/(.*)$ /Ascendance/intelligence/$1 [R=301,L]

  RewriteCond %{ENV:SITE_ENV} =local
  RewriteRule ^blog/?$ /Ascendance/intelligence/ [R=301,L]

  # — LIVE: root-level redirects ———————————————————————————————————————————
  RewriteCond %{ENV:SITE_ENV} !=local
  RewriteRule ^contact-us/?$ /contact/ [R=301,L]

  RewriteCond %{ENV:SITE_ENV} !=local
  RewriteRule ^services-and-industries/?$ /services/ [R=301,L]

  RewriteCond %{ENV:SITE_ENV} !=local
  RewriteRule ^blog/(.*)$ /intelligence/$1 [R=301,L]

  RewriteCond %{ENV:SITE_ENV} !=local
  RewriteRule ^blog/?$ /intelligence/ [R=301,L]
</IfModule>

# ── 7. Robots.txt Routing ─────────────────────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^robots\.txt$ index.php?robots=1 [L,QSA]
</IfModule>

# ── 8. WordPress Core Rewrites (Auto-path, no hardcoding) ────────────────────
<IfModule mod_rewrite.c>
RewriteEngine On

# Pass Authorization header to PHP (needed for REST API / JWT)
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Always pass through existing index.php (prevents infinite loop)
RewriteRule ^index\.php$ - [L]

# — LOCAL: missing files/dirs → /Ascendance/index.php ———————————————————————
RewriteCond %{ENV:SITE_ENV} =local
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /Ascendance/index.php [L]

# — LIVE: missing files/dirs → /index.php ————————————————————————————————————
RewriteCond %{ENV:SITE_ENV} !=local
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]

</IfModule>
# BEGIN WordPress
# The directives (lines) between "BEGIN WordPress" and "END WordPress" are
# dynamically generated, and should only be modified via WordPress filters.
# Any changes to the directives between these markers will be overwritten.
# Protect wp-config and env
<IfModule mod_rewrite.c>
RewriteRule (^|/)(?:\.env|wp-config.php) - [F,L]
</IfModule>
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteBase /Ascendance/
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /Ascendance/index.php [L]
</IfModule>

# END WordPress